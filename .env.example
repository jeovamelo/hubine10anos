# Hubine 10 Anos - Variáveis de Ambiente
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=hubine-10-anos-chave-secreta-jwt-2026

# Configuração de E-mail (SMTP)
# Caso não configurado, o sistema opera automaticamente em MODO DEMONSTRAÇÃO
# exibindo todos os e-mails na aba "Caixa de E-mails" do painel da organização.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hubine 10 Anos <hubine10anos@bnb.gov.br>"
